{
  "name": "backend",
  "version": "1.0.0",
  "description": "SHAIVIKA AI LMS Express Backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/copy-shared.js && cross-env NODE_OPTIONS=--openssl-legacy-provider nodemon",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/copy-shared.js && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc && node scripts/copy-assets.js",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider node dist/server.js",
    "test": "jest --runInBand --forceExit --testTimeout=30000",
    "seed:react": "npx ts-node src/scripts/seed-react-course.ts",
    "import:lessons": "npx tsx src/scripts/importLessons.ts",
    "migrate:courses": "npx ts-node src/scripts/migrateCourseContentToFirestore.ts",
    "migrate:course-content": "npx tsx scripts/migrate-course-content.ts",
    "backup:courses": "npx tsx scripts/backup-course-content.ts",
    "cleanup:legacy-course-data": "npx tsx scripts/cleanup-legacy-course-data.ts",
    "audit:legacy-decommission": "npx tsx scripts/audit-legacy-decommission.ts",
    "decommission:legacy-collections": "npx tsx scripts/delete-legacy-collections.ts",
    "oauth:gen": "npx ts-node scripts/generate-google-oauth-token.ts"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.1.0",
    "googleapis": "^174.0.1",
    "helmet": "^8.0.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "resend": "^6.18.0",
    "socket.io": "^4.8.3",
    "typescript": "^5.7.3",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  }
}
