# ==============================================================================
# KAIZENQ AI LMS BACKEND PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server Environment & Port Configuration
NODE_ENV=production
PORT=5000
JWT_SECRET=kaizenq_production_jwt_secret_key_change_me_in_render

# Frontend URL & Production CORS Configuration
FRONTEND_URL=https://www.kaizenq.in,https://kaizenq.in
CORS_ORIGIN=https://www.kaizenq.in,https://kaizenq.in,http://localhost:5173

# Google Gemini AI Integration Key
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Email Notification Provider (resend | nodemailer | mock)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=KaizenQ LMS <notifications@shaivika.com>

# Firebase Admin SDK Production Service Account Credentials
FIREBASE_PROJECT_ID=shaivika-lms-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@shaivika-lms-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7HjiVb+71Yt94...\n-----END PRIVATE KEY-----\n"

# Google Slides & Drive OAuth Credentials (Required if Service Account storage quota error occurs)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token_here
