rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isInstructor() {
      return isAuthenticated() && (
        request.auth.token.role == 'instructor' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'instructor') ||
        isAdmin()
      );
    }
    
    function isAssignedInstructor(resourceData) {
      return isInstructor() && (resourceData.instructorId == request.auth.uid || resourceData.createdBy == request.auth.uid);
    }

    function liveClassMetadataUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'instructorId', 'courseId', 'createdBy', 'startTime', 'endTime', 'status', 'meetingRoomId', 'meetingUrl'
      ]) == false;
    }

    // --- CORE USER & PROFILE COLLECTIONS ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 3. Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(studentId);
      allow update, delete: if isAdmin() || isOwner(studentId);
    }

    // 3b. Instructors Collection
    match /instructors/{instructorId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(instructorId);
    }

    // --- CURRICULUM & COURSE CONTENT COLLECTIONS ---

    // 4. Courses Collection (Root & Subcollections)
    match /courses/{courseId} {
      allow read: if true; // Public catalog view
      allow write: if isAdmin() || isInstructor();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin() || isInstructor();
      }
    }

    // 5. Modules
    match /modules/{id} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }

    // 6. Lessons
    match /lessons/{id} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }

    // 7. Course Modules Aux
    match /course_modules/{id} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }

    // 8. Course Lessons Aux
    match /course_lessons/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // 9. Course Knowledge
    match /course_knowledge/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // 10. Question Bank
    match /question_bank/{id} {
      allow read, write: if isAdmin() || isInstructor();
    }

    // 11. Generated Quizzes
    match /generated_quizzes/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // 12. Resources
    match /resources/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // 13. Quizzes
    match /quizzes/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // 14. Assignments
    match /assignments/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // --- ENROLLMENT, PROGRESS & ASSESSMENT COLLECTIONS ---

    // 15. Enrollments
    match /enrollments/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 16. Progress
    match /progress/{id} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow write: if isAuthenticated() && (isAdmin() || request.resource.data.studentId == request.auth.uid);
    }

    // 17. Student Progress
    match /student_progress/{progressId} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow write: if isAuthenticated() && (isAdmin() || isInstructor() || request.resource.data.studentId == request.auth.uid);
    }

    // 18. Student Analysis
    match /student_analysis/{analysisId} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow write: if isAdmin() || isInstructor();
    }

    // 19. Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin() || isInstructor();
    }

    // 20. Assignment Submissions
    match /assignment_submissions/{submissionId} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin() || isInstructor();
    }

    // 21. Certificates
    match /certificates/{certificateId} {
      allow read: if true; // Public certificate verification
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // --- SYSTEM, NOTIFICATIONS & AUDIT COLLECTIONS ---

    // 22. Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.recipientId == request.auth.uid || 
        resource.data.recipientRole == 'all' ||
        resource.data.recipientRole == 'student'
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 23. Email Logs
    match /email_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 24. Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // --- LIVE CLASSROOM SYSTEM (HIERARCHICAL ARCHITECTURE) ---

    // 25. Live Classes Root Collection
    match /liveClasses/{classId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAssignedInstructor(resource.data) && request.resource.data.instructorId == resource.data.instructorId && request.resource.data.courseId == resource.data.courseId && request.resource.data.createdBy == resource.data.createdBy);

      // 25.1 Subcollection: attendance
      match /attendance/{attendanceId} {
        allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isAdmin() || isInstructor();
      }

      // 25.2 Subcollection: chat
      match /chat/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAdmin() || isAssignedInstructor(get(/databases/$(database)/documents/liveClasses/$(classId)).data) || (isAuthenticated() && resource.data.senderId == request.auth.uid && request.resource.data.senderId == resource.data.senderId && request.resource.data.senderName == resource.data.senderName && request.resource.data.senderRole == resource.data.senderRole);
        allow delete: if isAdmin() || isAssignedInstructor(get(/databases/$(database)/documents/liveClasses/$(classId)).data);
      }

      // 25.3 Subcollection: questions
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isAdmin() || isAssignedInstructor(get(/databases/$(database)/documents/liveClasses/$(classId)).data);
      }

      // 25.4 Subcollection: notes
      match /notes/{noteId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // 25.5 Subcollection: resources
      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // 25.6 Subcollection: polls
      match /polls/{pollId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // 25.7 Subcollection: quizzes
      match /quizzes/{quizId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // 25.8 Subcollection: quizAttempts
      match /quizAttempts/{attemptId} {
        allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isAdmin() || isInstructor();
      }

      // 25.9 Subcollection: recordings
      match /recordings/{recordingId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // 25.10 Subcollection: announcements
      match /announcements/{announcementId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // 25.11 Subcollection: analytics
      match /analytics/{analyticsId} {
        allow read, write: if isAdmin() || isInstructor();
      }
    }

    // --- 26. EMAIL PROTECTION RULES (PREVENT CLIENT SPAM / ROGUE MAIL TRIGGERS) ---
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    match /emails/{emailId} {
      allow read, write: if isAdmin();
    }

    match /mail_triggers/{triggerId} {
      allow read, write: if isAdmin();
    }

    // --- 27. DEVELOPER PORTFOLIO SYSTEM ---
    match /portfolios/{studentId} {
      allow read: if true; // Public portfolio showcase
      allow create, update: if isAuthenticated() && (isOwner(studentId) || isAdmin());
      allow delete: if isAdmin() || isOwner(studentId);
    }

    match /portfolio_handles/{handle} {
      allow read: if true; // Public handle resolution
      allow write: if isAuthenticated();
    }

    // --- 28. RESUME BUILDER DRAFTS ---
    match /resumes/{studentId} {
      allow read, write: if isAuthenticated() && (isOwner(studentId) || isAdmin());
    }

    // --- 29. PAYMENTS & TRANSACTIONS (SECURED AGAINST TAMPERING) ---
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
