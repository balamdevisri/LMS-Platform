rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isInstructor() {
      return isAuthenticated() && (
        request.auth.token.role == 'instructor' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'instructor') ||
        isAdmin()
      );
    }
    
    function isAssignedInstructor(resourceData) {
      return isInstructor() && (
        resourceData.instructorId == request.auth.uid || 
        resourceData.createdBy == request.auth.uid
      );
    }

    // =========================================================================
    // 1. CORE USER & ROLE MANAGEMENT
    // =========================================================================

    // Users Collection (Central Profile Repository)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(studentId);
      allow update, delete: if isAdmin() || isOwner(studentId);
    }

    // Instructors Collection
    match /instructors/{instructorId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(instructorId);
    }

    // Leaderboard Collection (Live Student Standings & XP)
    match /leaderboard/{userId} {
      allow read: if true; // Public live rankings
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Live Classes Collection
    match /liveClasses/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isInstructor();
      allow update, delete: if isAdmin() || isAssignedInstructor(resource.data) || resource.data.createdBy == request.auth.uid;

      // Subcollections: attendance, chats, polls, questions, notes
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // =========================================================================
    // 2. CURRICULUM, COURSES, MODULES & LESSONS (HIERARCHICAL & FLAT)
    // =========================================================================

    // Courses Collection (Root and Nested Subcollections)
    match /courses/{courseId} {
      allow read: if true; // Public catalog access
      allow write: if isAuthenticated();

      // Nested Subcollection: courses/{courseId}/modules/{moduleId}
      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAuthenticated();

        // Nested Subcollection: courses/{courseId}/modules/{moduleId}/lessons/{lessonId}
        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
      }

      // Catch-all for any other nested subcollections under courses
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Top-Level Modules & Lessons collections decommissioned in Phase 4G.
    // Canonical curriculum is governed strictly under /courses/{courseId}/modules/...

    match /course_knowledge/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    match /question_bank/{id} {
      allow read, write: if isAdmin() || isInstructor();
    }

    match /generated_quizzes/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    match /resources/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    match /quizzes/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    match /assignments/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // =========================================================================
    // 3. ENROLLMENTS, PROGRESS, ATTEMPTS & CERTIFICATES
    // =========================================================================

    // Enrollments (Protected — created/managed via Backend Admin SDK)
    match /enrollments/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Student Progress Collection (Protected — managed via Backend Admin SDK)
    match /student_progress/{progressId} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Student Learning Analytics
    match /student_analysis/{analysisId} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow write: if isAdmin() || isInstructor();
    }

    // Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin() || isInstructor();
    }

    // Assignment Submissions
    match /assignment_submissions/{submissionId} {
      allow read: if isAuthenticated() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin() || isInstructor();
    }

    // Certificates (Public Verification by verificationId/certId — Generated strictly via Backend Admin SDK)
    match /certificates/{certificateId} {
      allow read: if true; // Public certificate verification
      allow write: if isAdmin();
    }

    // Certificate Jobs Queue (Managed strictly via Backend Admin SDK)
    match /certificateJobs/{jobId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.studentUid == request.auth.uid || 
        resource.data.studentId == request.auth.uid
      );
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. NOTIFICATIONS, SYSTEM LOGS & AUDIT
    // =========================================================================

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.recipientId == request.auth.uid || 
        resource.data.recipientRole == 'all' ||
        resource.data.recipientRole == 'student'
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /email_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 5. LIVE CLASSROOM SYSTEM (HIERARCHICAL)
    // =========================================================================

    match /liveClasses/{classId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAssignedInstructor(resource.data) && 
        request.resource.data.instructorId == resource.data.instructorId && 
        request.resource.data.courseId == resource.data.courseId && 
        request.resource.data.createdBy == resource.data.createdBy
      );

      // Attendance Subcollection
      match /attendance/{attendanceId} {
        allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isAdmin() || isInstructor();
      }

      // Chat Subcollection
      match /chat/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAdmin() || 
          isAssignedInstructor(get(/databases/$(database)/documents/liveClasses/$(classId)).data) || 
          (isAuthenticated() && resource.data.senderId == request.auth.uid);
        allow delete: if isAdmin() || isAssignedInstructor(get(/databases/$(database)/documents/liveClasses/$(classId)).data);
      }

      // Questions Subcollection
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isAdmin() || isAssignedInstructor(get(/databases/$(database)/documents/liveClasses/$(classId)).data);
      }

      // Notes Subcollection
      match /notes/{noteId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // Resources Subcollection
      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // Polls Subcollection
      match /polls/{pollId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // Quizzes Subcollection
      match /quizzes/{quizId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // Quiz Attempts Subcollection
      match /quizAttempts/{attemptId} {
        allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isAdmin() || isInstructor();
      }

      // Recordings Subcollection
      match /recordings/{recordingId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // Announcements Subcollection
      match /announcements/{announcementId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isInstructor();
      }

      // Analytics Subcollection
      match /analytics/{analyticsId} {
        allow read, write: if isAdmin() || isInstructor();
      }
    }

    // =========================================================================
    // 6. TRANSACTIONAL MAILS & TRIGGERS (ADMIN ONLY)
    // =========================================================================
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    match /emails/{emailId} {
      allow read, write: if isAdmin();
    }

    match /mail_triggers/{triggerId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 7. DEVELOPER PORTFOLIO & RESUME BUILDER
    // =========================================================================
    match /portfolios/{studentId} {
      allow read: if true; // Public portfolio showcase
      allow create, update: if isAuthenticated() && (isOwner(studentId) || isAdmin());
      allow delete: if isAdmin() || isOwner(studentId);
    }

    match /portfolio_handles/{handle} {
      allow read: if true; // Public handle resolution
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    match /resumes/{studentId} {
      allow read, write: if isAuthenticated() && (isOwner(studentId) || isAdmin());
    }

    // =========================================================================
    // 8. PAYMENTS & TRANSACTIONS
    // =========================================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // =========================================================================
    // 9. LIVE CLASSROOM & REAL-TIME INTERACTION
    // =========================================================================
    match /liveClasses/{classId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /chat/{messageId} {
        allow read: if true;
        allow create: if isAuthenticated() || true;
        allow update, delete: if isAuthenticated();
      }

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /attendance/{studentId} {
        allow read, write: if isAuthenticated();
      }

      match /polls/{pollId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /quizzes/{quizId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }
  }
}
