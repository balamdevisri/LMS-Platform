rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserDoc(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.matches('.*admin.*') || 
         request.auth.token.email == 'admin@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().role == 'admin'));
    }

    function isInstructor() {
      return isAuthenticated() && 
        (request.auth.token.email.matches('.*instructor.*') || 
         request.auth.token.email.matches('.*mentor.*') ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().role == 'instructor'));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Protection helper to prevent non-admins from changing protected system fields
    function notModifyingProtectedFields() {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approvedBy', 'approvedAt', 'createdAt']));
    }

    // =========================================================
    // 1. USERS COLLECTION (Central Identity)
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isUserDoc(userId);
      allow update: if isAdmin() || (isOwner(userId) && notModifyingProtectedFields());
      allow delete: if isAdmin();
    }

    // =========================================================
    // 2. STUDENTS COLLECTION
    // =========================================================
    match /students/{studentId} {
      allow read: if isAdmin() || isInstructor() || isOwner(studentId);
      allow create: if isAuthenticated() && isUserDoc(studentId);
      allow update: if isAdmin() || (isOwner(studentId) && notModifyingProtectedFields());
      allow delete: if isAdmin();
    }

    // =========================================================
    // 3. INSTRUCTORS COLLECTION
    // =========================================================
    match /instructors/{instructorId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isUserDoc(instructorId);
      allow update: if isAdmin() || (isOwner(instructorId) && notModifyingProtectedFields());
      allow delete: if isAdmin();
    }

    // =========================================================
    // 4. ADMINS COLLECTION
    // =========================================================
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================
    // 5. COURSES COLLECTION
    // =========================================================
    match /courses/{courseId} {
      allow read: if true; // Public catalog
      allow create: if isAdmin() || isInstructor();
      allow update: if isAdmin() || (isInstructor() && resource.data.createdBy == request.auth.uid && notModifyingProtectedFields());
      allow delete: if isAdmin();
    }

    // =========================================================
    // 6. MODULES & LESSONS COLLECTIONS
    // =========================================================
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // =========================================================
    // 7. ENROLLMENTS COLLECTION
    // =========================================================
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // =========================================================
    // 8. PROGRESS COLLECTION
    // =========================================================
    match /progress/{progressId} {
      allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /student_progress/{progressId} {
      allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // =========================================================
    // 9. QUIZZES & 10. ASSIGNMENTS COLLECTIONS
    // =========================================================
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    match /quiz_attempts/{attemptId} {
      allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    match /assignment_submissions/{subId} {
      allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // =========================================================
    // 11. ATTENDANCE & 12. LIVE CLASSES COLLECTIONS
    // =========================================================
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin() || isInstructor();
    }

    match /liveClasses/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // =========================================================
    // 13. NOTIFICATIONS COLLECTION
    // =========================================================
    match /notifications/{notifId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && 
                     (resource.data.recipientId == request.auth.uid || 
                      resource.data.recipientRole == 'all' || 
                      resource.data.recipientRole == 'student' ||
                      resource.data.recipientRole == 'instructor' ||
                      resource.data.userId == request.auth.uid));
      allow create: if isAdmin() || isInstructor();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.recipientId == request.auth.uid);
    }

    // =========================================================
    // 14. CERTIFICATES COLLECTION
    // =========================================================
    match /certificates/{certificateId} {
      allow read: if true; // Public verification allowed via verificationId
      allow write: if isAdmin();
    }

    // =========================================================
    // 15. AUDIT LOGS & EMAIL LOGS
    // =========================================================
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /email_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
