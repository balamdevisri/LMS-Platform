rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isInstructor() {
      return isAuthenticated() && (
        getUserData().role == 'instructor' || 
        request.auth.token.role == 'instructor' ||
        request.auth.token.role == 'admin'
      );
    }
    
    function isAssignedInstructor(resourceData) {
      return isInstructor() && resourceData.instructorId == request.auth.uid;
    }

    // Users Collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isOwner(userId);
    }

    // Students Collection rules
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if true; // Allow self registration
      allow update, delete: if isAdmin() || isOwner(studentId);
    }

    // Courses & syllabus structures
    match /courses/{courseId} {
      allow read: if true; // Public view
      allow write: if isAdmin() || isInstructor();
    }

    match /course_modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }

    match /course_lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // Student Progress Tracking
    match /student_progress/{progressId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow write: if isAuthenticated() && (isAdmin() || request.resource.data.studentId == request.auth.uid);
    }

    match /student_analysis/{analysisId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Certificates
    match /certificates/{certificateId} {
      allow read: if true; // Certificates can be verified publicly
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.recipientId == request.auth.uid || 
        resource.data.recipientRole == 'all'
      );
      allow write: if isAdmin();
    }

    // Audit logs & email logs
    match /email_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Root Collection: liveClasses
    match /liveClasses/{classId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isAssignedInstructor(resource.data);

      // Subcollection: attendance
      match /attendance/{attendanceId} {
        allow read: if isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isInstructor();
      }

      // Subcollection: chat
      match /chat/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isInstructor() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
      }

      // Subcollection: questions
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isInstructor();
      }

      // Subcollection: notes
      match /notes/{noteId} {
        allow read: if isAuthenticated();
        allow write: if isInstructor();
      }

      // Subcollection: resources
      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow write: if isInstructor();
      }

      // Subcollection: polls
      match /polls/{pollId} {
        allow read: if isAuthenticated();
        allow write: if isInstructor();
      }

      // Subcollection: quizzes
      match /quizzes/{quizId} {
        allow read: if isAuthenticated();
        allow write: if isInstructor();
      }

      // Subcollection: quizAttempts
      match /quizAttempts/{attemptId} {
        allow read: if isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isInstructor();
      }

      // Subcollection: recordings
      match /recordings/{recordingId} {
        allow read: if isAuthenticated();
        allow write: if isInstructor();
      }

      // Subcollection: announcements
      match /announcements/{announcementId} {
        allow read: if isAuthenticated();
        allow write: if isInstructor();
      }

      // Subcollection: analytics
      match /analytics/{analyticsId} {
        allow read, write: if isInstructor();
      }
    }
  }
}
